  "engines": { "node": ">=18" },
  "keywords": ["developer-tools", "git", "context-switching", "dashboard", "cli", "local-first", "projects"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "author": "Galvora Labs",
  "homepage": "https://github.com/galvoralabs/leftoff",
  "repository": { "type": "git", "url": "git+https://github.com/galvoralabs/leftoff.git" }
}
